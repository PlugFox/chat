# Copy to deploy/.env (gitignored) and fill in. Every variable: docs/configuration.md.
CHAT_DOMAIN=chat.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Root of the server's keys: `openssl rand -base64 32`. Without it every
# restart signs clients in again silently (docs/auth.md).
CHAT_SERVER_SECRET=

# Sign-in: set at least one method.
# Email codes over SMTP, e.g. smtps://user:password@smtp.example.com:465
CHAT_SMTP_URL=
CHAT_SMTP_FROM=Vault Chat <chat@example.com>
# Google: an OAuth client of type "Web application" with the redirect URI
# https://<CHAT_DOMAIN>/auth/google/callback
CHAT_GOOGLE_CLIENT_ID=
CHAT_GOOGLE_CLIENT_SECRET=
# Who may create an account: comma-separated globs, e.g. me@example.org or
# *@example.org. Empty means anyone who can sign in.
CHAT_SIGNUP_ALLOW=

# Optional: IP-to-country database mounted from deploy/geoip
# (docs/deployment.md, "Country"), e.g. /geoip/country.mmdb
CHAT_GEOIP_DB=

# Optional: private networks users' LLM base URLs may reach (Ollama on the LAN).
CHAT_PROVIDER_ALLOWED_NETWORKS=
RUST_LOG=info
