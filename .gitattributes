# LF everywhere, so a Windows checkout with core.autocrlf cannot turn the hook
# scripts or the SQL migrations (checksummed by sqlx) into CRLF.
* text=auto eol=lf

# Binary fixtures and build outputs.
*.der  binary
*.wasm binary
*.png  binary
*.mmdb binary

# Generated files: collapsed in diffs, rewritten by their generators.
client/src/protocol/generated/** linguist-generated=true
crates/crypto/vectors/*.json     linguist-generated=true
Cargo.lock                       linguist-generated=true
client/bun.lock                  linguist-generated=true
