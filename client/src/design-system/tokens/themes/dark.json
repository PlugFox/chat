{
  "$description": "Dark theme.",
  "$extensions": { "chat.theme": { "colorScheme": "dark" } },
  "color": {
    "bg": {
      "default": { "$value": "{color.neutral.950}" },
      "subtle": { "$value": "{color.neutral.850}" },
      "raised": { "$value": "{color.neutral.900}" },
      "inverse": { "$value": "{color.neutral.100}" }
    },
    "fg": {
      "default": { "$value": "{color.neutral.100}" },
      "muted": { "$value": "{color.neutral.400}" },
      "inverse": { "$value": "{color.neutral.950}" },
      "link": { "$value": "{color.indigo.300}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.800}" },
      "strong": { "$value": "{color.neutral.550}" }
    },
    "accent": {
      "default": { "$value": "{color.indigo.300}" },
      "fg": { "$value": "{color.neutral.950}" },
      "subtle": { "$value": "{color.indigo.900}" },
      "subtle-fg": { "$value": "{color.indigo.200}" }
    },
    "danger": {
      "default": { "$value": "{color.red.400}" },
      "fg": { "$value": "{color.neutral.950}" },
      "subtle": { "$value": "{color.red.950}" },
      "subtle-fg": { "$value": "{color.red.300}" }
    },
    "success": {
      "subtle": { "$value": "{color.green.950}" },
      "subtle-fg": { "$value": "{color.green.300}" }
    },
    "warning": {
      "subtle": { "$value": "{color.amber.950}" },
      "subtle-fg": { "$value": "{color.amber.300}" }
    },
    "focus": { "$value": "{color.indigo.300}" },
    "scrim": { "$value": "color-mix(in srgb, {color.neutral.950} 70%, transparent)" },
    "chart": {
      "$description": "Chart series in order; a series keeps its slot. Some light ones are under 3:1 on the surface, so a chart has a legend and a table view.",
      "1": { "$value": "{color.series.dark.1}" },
      "2": { "$value": "{color.series.dark.2}" },
      "3": { "$value": "{color.series.dark.3}" },
      "4": { "$value": "{color.series.dark.4}" },
      "5": { "$value": "{color.series.dark.5}" },
      "6": { "$value": "{color.series.dark.6}" },
      "7": { "$value": "{color.series.dark.7}" },
      "8": { "$value": "{color.series.dark.8}" }
    },
    "qr": {
      "$description": "Dark modules on a light ground in every theme: phone cameras read inverted codes poorly.",
      "dark": { "$value": "{color.neutral.1000}" },
      "light": { "$value": "{color.white}" }
    }
  },
  "shadow": {
    "sm": { "$value": "0 0.0625rem 0.25rem color-mix(in srgb, {color.neutral.950} 40%, transparent)" },
    "md": { "$value": "0 0.25rem 1rem color-mix(in srgb, {color.neutral.950} 50%, transparent)" }
  }
}
